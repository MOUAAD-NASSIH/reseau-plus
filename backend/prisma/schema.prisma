// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  users User[]

  @@map("roles")
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  worker      Worker?
  institution Institution?

  @@map("users")
}

model Worker {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  firstName       String
  lastName        String
  speciality      String
  experienceYears Int
  bio             String?
  location        String?
  isApproved      Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("workers")
}

model Institution {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  institutionName String
  address         String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("institutions")
}
